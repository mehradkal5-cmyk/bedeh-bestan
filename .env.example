# Public browser values. These are safe to expose, but do not commit real values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Function secrets: set with `supabase secrets set`, never in this file or browser code.
# CARD_ENCRYPTION_KEY=base64-encoded-32-byte-key
# SUPABASE_SERVICE_ROLE_KEY=server-only
# WEB_PUSH_VAPID_PUBLIC_KEY=optional
# WEB_PUSH_VAPID_PRIVATE_KEY=optional
